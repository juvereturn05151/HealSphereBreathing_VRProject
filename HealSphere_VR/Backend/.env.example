# Keep the real key only in Backend/.env. Never copy it into Unity.
TRIPO_API_KEY=replace_with_your_tripo_key
# Local development access capability, NOT the Tripo key. Use a random value (32+ chars).
BACKEND_ACCESS_TOKEN=replace_with_random_local_access_token
HOST=127.0.0.1
PORT=3000
# Explicit opt-in before the single paid test. Restart backend after editing.
ENABLE_GENERATION=false
# Signed output host allowlist; exact hosts or their subdomains, HTTPS only.
MODEL_DOWNLOAD_HOSTS=tripo3d.ai
