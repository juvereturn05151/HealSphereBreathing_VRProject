# Keep the real key only in Backend/.env. Never copy it into Unity.
TRIPO_API_KEY=replace_with_your_tripo_key
# Local development access capability, NOT the Tripo key. Use a random value (32+ chars).
BACKEND_ACCESS_TOKEN=replace_with_random_local_access_token
HOST=127.0.0.1
PORT=3000
# Keep disabled: the authorized test is already complete. Future paid work needs separate authorization.
ENABLE_GENERATION=false
# Signed output host allowlist; exact hosts or their subdomains, HTTPS only.
MODEL_DOWNLOAD_HOSTS=tripo3d.ai,openapi-dl.data.tripo3d.com
# Creation conversation (server only). Empty key enables labeled deterministic fallback.
OPENAI_API_KEY=replace_with_your_openai_key
OPENAI_MODEL=gpt-4.1-mini
ALLOW_OFFLINE_CONVERSATION=true
# openai reviews the generated preview before serving; missing/failed review requires operator approval.
# manual waits for operator approval; none skips visual/manual approval after GLB validation (explicit owner opt-in).
MODEL_REVIEW_MODE=openai
# Optional reviewed local GLB, relative to Backend. No network/paid calls in demo mode.
DEMO_GLB_PATH=

# Persistent library and durable cost budget. Do not raise the lifetime budget without new authorization.
# Set either count quota to -1 to disable it explicitly; 0 blocks new paid tasks.
MAX_LIFETIME_PAID_GENERATIONS=1
MAX_GENERATIONS_PER_SESSION=1
MAX_SIMULTANEOUS_GENERATIONS=1
GENERATION_TIMEOUT_SECONDS=900
MAX_REQUESTS_PER_MINUTE=60
MAX_MODEL_BYTES=33554432
MAX_RETAINED_STORAGE_BYTES=536870912
ALLOWED_GENERATION_PROVIDERS=tripo
# Only enable for this owner-approved private prototype collection.
SHARED_COLLECTION_ENABLED=false
